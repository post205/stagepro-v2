# StagePro — env template. Copy to .env (gitignored) and fill real values.

# Supabase DB password (chosen at `supabase projects create`)
SUPABASE_DB_PASSWORD=

# Project identifiers (from the Supabase dashboard / CLI after create)
STAGEPRO_PROJECT_REF=
STAGEPRO_SUPABASE_URL=          # https://<ref>.supabase.co
STAGEPRO_SUPABASE_ANON_KEY=     # publishable (browser-safe) key

# Edge-function secrets
TURNSTILE_SECRET=               # dev: 1x0000000000000000000000000000000AA
TURNSTILE_SITEKEY=              # dev: 1x00000000000000000000BB
RESEND_API_KEY=
OWNER_NOTIFY_EMAIL=
